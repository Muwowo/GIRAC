{
  "backend": "exact_nns",
  "protocol": "heldout",
  "scaling": "identity",
  "dimensions": [2, 3, 1],
  "window": 4,
  "bounds": {
    "u_min": -1.0,
    "u_max": 1.0,
    "du_max": 0.1,
    "o_min": -1.0,
    "o_max": 1.0
  },
  "conditions": [
    {"name": "WC1", "csv": "../data/nns/case1_wc_1.csv", "target": [0.4], "gains": [1.0, 1.0, 1.0, 1.0]},
    {"name": "WC2", "csv": "../data/nns/case1_wc_2.csv", "target": [0.78], "gains": [1.15, 1.10, 0.85, 1.25]},
    {"name": "WC3", "csv": "../data/nns/case1_wc_3.csv", "target": [1.75], "gains": [1.30, 1.20, 0.70, 1.50]}
  ],
  "evaluation_starts": 5,
  "training": {
    "episodes": 100,
    "horizon": 200,
    "warmup_steps": 2000,
    "update_every": 10,
    "switch_episode": 75,
    "ramp_episodes": 25,
    "ramp_origin": "robust_phase",
    "alpha_start": 0.0
  }
}
